# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.log

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/
dist/
.env

# Runtime/static assets are stored in OSS. Keep them out of Git.
/static/*
!/static/.gitkeep
!/static/wl/
!/static/wl/**

# idea
.idea
*.iml
*.ipr
*.iws

cmd/casino/casino

# Firebase Admin private key. Deployment provides this file next to casino.yml.
/configs/firebase-service-account.json
