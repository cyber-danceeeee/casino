# Need to package the code first `tar zcf casino.tar.gz $(ls)` and move it to the same directory as Dokerfile

# Compile the go code, you can specify the golang version
FROM golang:1.24-alpine as build
COPY . /go/src/casino
WORKDIR /go/src/casino
RUN tar zxf casino.tar.gz
RUN go env -w GOPROXY=https://goproxy.cn,direct
RUN go mod download
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /casino cmd/casino/main.go

# compressing binary files
#cd /
