GAME_SOFTAGGREGATOR_ENABLED=false
GAME_SOFTAGGREGATOR_API_BASE_URL=https://api.softaggregator.com
GAME_SOFTAGGREGATOR_API_LOGIN=your-api-login
GAME_SOFTAGGREGATOR_API_PASSWORD=your-api-password
GAME_SOFTAGGREGATOR_SALT_KEY=your-callback-salt
GAME_SOFTAGGREGATOR_CALLBACK_PATH=/api/v1/game/providers/softaggregator/callback
GAME_SOFTAGGREGATOR_CALLBACK_IP_ALLOWLIST=
GAME_SOFTAGGREGATOR_MAX_TIMESTAMP_DRIFT_SECONDS=30
GAME_SOFTAGGREGATOR_REQUEST_TIMEOUT_SECONDS=10
GAME_SOFTAGGREGATOR_CONNECT_TIMEOUT_SECONDS=3
GAME_SOFTAGGREGATOR_MAX_TRANSACTION_AMOUNT_MINOR=100000000

# RabbitMQ production Event Bus adapter
CASINO_RABBITMQ_ENABLED=false
CASINO_RABBITMQ_REQUIRED=false
CASINO_RABBITMQ_HOST=127.0.0.1
CASINO_RABBITMQ_PORT=5672
CASINO_RABBITMQ_MANAGEMENT_PORT=15672
CASINO_RABBITMQ_USERNAME=casino
CASINO_RABBITMQ_PASSWORD=replace-me
CASINO_RABBITMQ_VHOST=/
CASINO_RABBITMQ_EXCHANGE=event.topic
CASINO_RABBITMQ_DIRECT_EXCHANGE=event.direct
CASINO_RABBITMQ_FANOUT_EXCHANGE=event.fanout
CASINO_RABBITMQ_RETRY_EXCHANGE=event.delay
CASINO_RABBITMQ_DEAD_EXCHANGE=event.dead
CASINO_RABBITMQ_PREFETCH=20
CASINO_RABBITMQ_CONCURRENCY=2
CASINO_RABBITMQ_PUBLISHER_CONFIRM=true
CASINO_RABBITMQ_PUBLISHER_TIMEOUT_MS=5000
CASINO_RABBITMQ_RECONNECT_DELAY_SECONDS=5
CASINO_RABBITMQ_MAX_RETRIES=5
