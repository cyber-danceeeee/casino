[Unit]
Description=Build and deploy the latest Casino main branch
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/casino
EnvironmentFile=-/etc/casino-update.env
ExecStart=/bin/bash /opt/casino/deploy/update-server.sh
TimeoutStartSec=1800
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
