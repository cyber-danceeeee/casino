# Recommended: python3 scripts/init-env.py (creates .env with unique secrets).
# For manual setup, copy this file to .env and fill every blank value.
TZ=Asia/Kuala_Lumpur
BIND_ADDRESS=0.0.0.0
H5_PORT=80
ADMIN_PORT=8080
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
RABBITMQ_PASSWORD=
# Exactly 32 random bytes, base64 encoded. Keep this key stable across deployments.
CASINO_MFA_ENCRYPTION_KEY=
# Initial password for system-admin, 12–72 UTF-8 bytes. Never resets existing passwords.
CASINO_BOOTSTRAP_ADMIN_PASSWORD=

# auto selects Nacos when NACOS_SERVER_ADDR is set; local explicitly uses the bundled YAML.
# A configured Nacos read failure stops startup. There is no fallback or hot reload.
CASINO_CONFIG_SOURCE=auto
NACOS_SERVER_ADDR=
# Nacos 2.3 public namespace: keep empty (do not write the literal word public).
NACOS_NAMESPACE_ID=
NACOS_GROUP=DEFAULT_GROUP
NACOS_DATA_ID=game
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_TIMEOUT_SECONDS=15
